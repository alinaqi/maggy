#!/bin/bash
# UserPromptSubmit hook — classifies each prompt (local Ollama model, then
# cheaper fallbacks) and injects routing instructions into Claude's context.
#
# Routing: FLASH_TIER → PRO_TIER → KIMI → CODEX → CLAUDE
# A tier is only emitted when its delegation binary is installed; otherwise the
# hook falls back to CLAUDE handling the task directly (no plan ceremony).
# Flash/Pro providers are resolved from ~/.maggy/routing.yaml
# Sovereignty modes: us (default) | local | any
#
# Exit 0 + additionalContext: Claude sees the routing tier.
# Falls back to cached tier when Ollama is unreachable (post-compact safety).
# No set -euo pipefail: hook scripts must be defensive, not strict.

INPUT=$(cat 2>/dev/null || true)
PROMPT=$(echo "$INPUT" | jq -r '.prompt // empty' 2>/dev/null || echo "")
CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null || echo ".")

# ── Load provider config from ~/.maggy/routing.yaml ─────────────────────────
ROUTING_CFG="$HOME/.maggy/routing.yaml"
SOVEREIGNTY="us"
FLASH_PROVIDER="groq"
PRO_PROVIDER="together"

if [ -f "$ROUTING_CFG" ]; then
  _yaml_val() { grep -m1 "^[[:space:]]*${1}:" "$ROUTING_CFG" 2>/dev/null | awk -F': ' '{print $2}' | tr -d ' \r\n' || true; }
  _SOVER=$(_yaml_val "sovereignty")
  _FLASH=$(_yaml_val "flash")
  _PRO=$(_yaml_val "pro")
  [ -n "$_SOVER" ] && SOVEREIGNTY="$_SOVER"
  [ -n "$_FLASH" ] && FLASH_PROVIDER="$_FLASH"
  [ -n "$_PRO" ]   && PRO_PROVIDER="$_PRO"
fi

# Sovereignty enforcement — override provider if blocked
_BLOCKED_US="deepseek kimi moonshot"
_BLOCKED_LOCAL="deepseek kimi moonshot groq together openai google anthropic"

_is_blocked() {
  local provider="$1"
  case "$SOVEREIGNTY" in
    us)    echo "$_BLOCKED_US" | grep -qw "$provider" && return 0 ;;
    local) echo "$_BLOCKED_LOCAL" | grep -qw "$provider" && return 0 ;;
  esac
  return 1
}

if _is_blocked "$FLASH_PROVIDER"; then
  FLASH_PROVIDER="ollama"
fi
if _is_blocked "$PRO_PROVIDER"; then
  PRO_PROVIDER=$( [ "$SOVEREIGNTY" = "local" ] && echo "ollama" || echo "groq" )
fi

# Resolve bin paths
_flash_bin() {
  case "$FLASH_PROVIDER" in
    groq)     echo "$HOME/bin/groq" ;;
    together) echo "$HOME/bin/together" ;;
    ollama)   echo "$HOME/bin/ollama-coder" ;;
    deepseek) echo "$HOME/bin/deepseek --flash" ;;
    *)        echo "$HOME/bin/groq" ;;
  esac
}
_pro_bin() {
  case "$PRO_PROVIDER" in
    together) echo "$HOME/bin/together" ;;
    groq)     echo "$HOME/bin/groq" ;;
    ollama)   echo "$HOME/bin/ollama-coder" ;;
    deepseek) echo "$HOME/bin/deepseek --pro" ;;
    *)        echo "$HOME/bin/together" ;;
  esac
}

FLASH_BIN=$(_flash_bin)
PRO_BIN=$(_pro_bin)

# Cost labels for context messages
_flash_cost() {
  case "$FLASH_PROVIDER" in
    groq)     echo "\$0.05/M" ;;
    together) echo "\$3.50/M" ;;
    ollama)   echo "free/local" ;;
    deepseek) echo "\$0.14/M" ;;
    *)        echo "" ;;
  esac
}
_pro_cost() {
  case "$PRO_PROVIDER" in
    together) echo "\$3.50/M" ;;
    groq)     echo "\$0.59/M" ;;
    ollama)   echo "free/local" ;;
    deepseek) echo "\$0.44/M" ;;
    *)        echo "" ;;
  esac
}

CACHE_FILE="$HOME/.claude/routing-cache.json"
LOG_FILE="$HOME/.claude/routing-log.jsonl"

# Followed (primary) model — shared with srooter + Maggy
PRIMARY_MODEL=$(python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.claude/model-config.json'))).get('primary',''))" 2>/dev/null || echo "")

# Skip empty prompts only
if [ -z "$PROMPT" ]; then
  exit 0
fi

# Skip if user explicitly says "use claude" (no need to route)
case "$PROMPT" in
  *"use claude"*|*"use Claude"*|*"USE CLAUDE"*) exit 0 ;;
esac

# ── Hardening: keep continuation/agentic work on the capable agent ───────────
# Signals used to detect "this prompt continues in-flight agentic work".
TRANSCRIPT=$(echo "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null || echo "")
WORD_COUNT=$(echo "$PROMPT" | wc -w | tr -d ' ')
_log_skip() {
  echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"tier\":\"SKIP\",\"reason\":\"$1\",\"task\":$(echo "$PROMPT" | jq -Rs .),\"source\":\"hook\"}" \
    >> "$LOG_FILE" 2>/dev/null || true
}
# Is the session mid-tool-use? A short follow-up then means "continue" and must
# NOT be handed to a tool-less delegate (groq/ollama), which narrates and stops.
_session_is_agentic() {
  [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ] || return 1
  tail -n 80 "$TRANSCRIPT" 2>/dev/null | grep -q '"type":"tool_use"' || return 1
  return 0
}

LOWER_PROMPT=$(echo "$PROMPT" | tr '[:upper:]' '[:lower:]')
TRIMMED=$(echo "$LOWER_PROMPT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/[.!?]*$//')
# Continuation phrases ("go ahead", "ok", "yes"…) = keep doing the current work.
case "$TRIMMED" in
  "go ahead"|"go"|"go on"|"continue"|"continue executing"|"keep executing"|"proceed"|"keep going"|"carry on"|"do it"|"run it"|"run"|"ok"|"okay"|"k"|"yes"|"yep"|"yeah"|"yes please"|"sure"|"next"|"next step"|"start"|"begin"|"execute") _log_skip "continuation_phrase"; exit 0 ;;
esac
# Execution-intent prompts need tools (validate-plan, deploy, implement).
case "$LOWER_PROMPT" in
  *"validate plan"*|*"validate-plan"*|*"validate the plan"*|*"start executing"*|*"execute the plan"*|*"run the plan"*|*"implement the plan"*|*"execute all tasks"*|*"start with task"*|*"begin implementation"*|*"continue the execution"*) _log_skip "execution_intent"; exit 0 ;;
esac
# Short prompt during an already-agentic session ≈ "continue" → stay on agent.
if [ "${WORD_COUNT:-0}" -le 6 ] 2>/dev/null && _session_is_agentic; then
  _log_skip "short_prompt_active_session"
  exit 0
fi

# ── Classification with cascading fallback ───────────────────────────────
# Try: qwen3 (free) → kimi (free) → deepseek-flash (cheap) → CLAUDE (always)
TIER=""
REASON=""
CLASSIFIER_USED=""

CLASSIFY_PROMPT="Classify this task into exactly ONE tier. Reply ONLY with the tier name followed by a colon and a short reason. No thinking tags.

Tiers:
- DEEPSEEK_FLASH: simple code tasks, boilerplate, CRUD endpoints, test writing, small bug fixes, config changes, single-file additions, formatting, shell one-liners, syntax lookups, log reading, short summaries
- GEMINI_FLASH_LITE: bulk extraction, classification pipelines, CIG data processing, large-scale cheap summarization, non-code batch tasks
- DEEPSEEK_PRO: multi-file features, refactors, debugging, medium-complexity coding, API endpoints, database queries, test suites, documentation writing
- GEMINI_FLASH: multimodal tasks, image screenshots analysis, video content processing, brand asset analysis, audio transcription review
- GEMINI_CLI: full coding agent with tools (grep, file read/write, MCP, web search), implements features end-to-end, debugging with execution, similar capability to Claude Code but via Gemini
- KIMI: single-file code review, medium reasoning, commit messages, summarising diffs or docs, research questions, changelog generation
- GROK: competitor intelligence, CKG building, deep reasoning, market analysis, truthful insights via xAI
- GEMINI_PRO_SEARCH: deep research with Google Search grounding, competitor intelligence, market research, 2M context document analysis
- CODEX: bulk boilerplate generation, mechanical changes across many files, large-scale test generation
- CLAUDE: architecture, security-critical code, complex debugging, system design, multi-service refactors, customer-facing quality-critical code

Task: ${PROMPT}"

TIERS_RE='DEEPSEEK_FLASH|GEMINI_FLASH_LITE|DEEPSEEK_PRO|GEMINI_FLASH|GEMINI_CLI|KIMI|GROK|GEMINI_PRO_SEARCH|CODEX|CLAUDE'

# Parse tier from raw classifier output
_classify_parse() {
  local raw="$1"
  [ -z "$raw" ] && return 1
  TIER=$(echo "$raw" | grep -oE "^($TIERS_RE)" || echo "")
  [ -z "$TIER" ] && return 1
  REASON=$(echo "$raw" | sed 's/^[A-Z_]*:\s*//')
  return 0
}

# Level 1: qwen3 via Ollama (free, local)
# Model + host are env-var configurable; defaults work on any machine with
# Ollama installed and `ollama pull qwen2.5-coder:3b` run.
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5-coder:3b}"
OLLAMA_BASE="${OLLAMA_BASE:-http://localhost:11434}"
if curl -s --connect-timeout 2 "${OLLAMA_BASE}/api/tags" >/dev/null 2>&1; then
  CONTENT=$(echo "$CLASSIFY_PROMPT" | jq -Rs .)
  RAW=$(curl -s --max-time 8 "${OLLAMA_BASE}/api/chat" \
    -d "{\"model\": \"${OLLAMA_MODEL}\", \"messages\": [{\"role\": \"user\", \"content\": ${CONTENT}}], \"stream\": false, \"options\": {\"temperature\": 0.1, \"num_predict\": 40}}" \
    2>/dev/null | jq -r '.message.content // ""' | head -1 || true)
  if _classify_parse "$RAW"; then
    CLASSIFIER_USED="qwen3"
  fi
fi

# Level 2: kimi CLI (free, local)
if [ -z "$TIER" ] && [ -x "$HOME/bin/kimi" ]; then
  RAW=$("$HOME/bin/kimi" --quiet -p "$CLASSIFY_PROMPT" 2>/dev/null || true)
  RAW=$(echo "$RAW" | tail -1)
  if _classify_parse "$RAW"; then
    CLASSIFIER_USED="kimi"
  fi
fi

# Level 3: flash provider (cheap API, ~$0.0001 per classification)
if [ -z "$TIER" ] && [ -x "$(echo $FLASH_BIN | awk '{print $1}')" ]; then
  # shellcheck disable=SC2086  # FLASH_BIN is a trusted "path --flag" from config;
  # word-splitting is intended. NO eval — the prompt stays a single quoted arg
  # so a task containing $(...) / backticks can never be executed (command injection).
  RAW=$($FLASH_BIN "$CLASSIFY_PROMPT" 2>/dev/null || true)
  RAW=$(echo "$RAW" | tail -1)
  if _classify_parse "$RAW"; then
    CLASSIFIER_USED="$FLASH_PROVIDER-flash"
  fi
fi

# Level 4: CLAUDE (fallback — always available)
if [ -z "$TIER" ]; then
  # Use cached tier if available
  if [ -f "$CACHE_FILE" ]; then
    TIER=$(cat "$CACHE_FILE" 2>/dev/null | jq -r '.tier // "CLAUDE"' 2>/dev/null || echo "CLAUDE")
    REASON="cached from $(cat "$CACHE_FILE" 2>/dev/null | jq -r '.ts // "?"' 2>/dev/null || echo "?")"
    CLASSIFIER_USED="cache"
    # A cached tier from an older hook version (e.g. a removed tier) must not leak through.
    if ! echo "$TIER" | grep -qxE "$TIERS_RE"; then
      REASON="cached tier '$TIER' is no longer supported"
      TIER="CLAUDE"
    fi
  else
    TIER="CLAUDE"
    REASON="all classifiers unavailable"
    CLASSIFIER_USED="none"
  fi
fi

# ── Cache the tier for post-compact resilience ───────────────────────────
echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"tier\":\"$TIER\",\"classifier\":\"$CLASSIFIER_USED\",\"reason\":$(echo "$REASON" | jq -Rs .)}" \
  > "$CACHE_FILE"

# ── Log routing decision ─────────────────────────────────────────────────
SAVED=0
case "$TIER" in
  DEEPSEEK_FLASH)    SAVED=3500 ;;
  GEMINI_FLASH_LITE) SAVED=3600 ;;
  DEEPSEEK_PRO)      SAVED=2500 ;;
  GEMINI_FLASH)      SAVED=2800 ;;
  KIMI)              SAVED=3000 ;;
  GEMINI_PRO_SEARCH) SAVED=1500 ;;
  CODEX)             SAVED=2000 ;;
esac

echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"task\":$(echo "$PROMPT" | jq -Rs .),\"tier\":\"$TIER\",\"tokens_saved\":$SAVED,\"classifier\":\"$CLASSIFIER_USED\",\"source\":\"hook\"}" \
  >> "$LOG_FILE"

# ── Project-local tool hints ─────────────────────────────────────────────
TOOLS_HINT=""
EDUBITES_ROOT="$HOME/Documents/edubites"
if [[ "$CWD" == "$EDUBITES_ROOT"* ]]; then
  PROJECT_DIR=$(echo "$CWD" | sed "s|${EDUBITES_ROOT}/||" | cut -d/ -f1)
  MONDAY_SCRIPT="${EDUBITES_ROOT}/${PROJECT_DIR}/scripts/monday"
  if [ -x "$MONDAY_SCRIPT" ]; then
    TOOLS_HINT=" PROJECT TOOLS: For Monday.com queries, run: ${MONDAY_SCRIPT} --help."
  fi
fi

# ── Mid-task escalation override ─────────────────────────────────────────
ESCALATION_FLAG="$HOME/.claude/mid-task-state/escalate"
if [ -f "$ESCALATION_FLAG" ]; then
  ESCALATION_COUNT=$(cat "$ESCALATION_FLAG" 2>/dev/null || echo "0")
  if [ "$ESCALATION_COUNT" -gt 0 ] 2>/dev/null; then
    # Force premium tier — escalate from current tier
    case "$TIER" in
      DEEPSEEK_FLASH|GEMINI_FLASH_LITE) TIER="DEEPSEEK_PRO" ;;  # escalate flash→pro
      DEEPSEEK_PRO|GEMINI_FLASH) TIER="CLAUDE" ;;
      KIMI) TIER="CLAUDE" ;;
    esac
    REASON="escalation: mid-task struggle detected, forced premium"
    # Increment counter (max 3 escalations per session)
    NEW_COUNT=$((ESCALATION_COUNT + 1))
    if [ "$NEW_COUNT" -le 3 ] 2>/dev/null; then
      echo "$NEW_COUNT" > "$ESCALATION_FLAG"
    fi
  fi
fi

# ── Delegation target must exist, else handle the task directly ──────────
# FLASH_BIN / PRO_BIN may carry flags ("…/deepseek --flash"); test the executable only.
_tier_bin() {
  case "$1" in
    DEEPSEEK_FLASH)                                   echo "${FLASH_BIN%% *}" ;;
    DEEPSEEK_PRO)                                     echo "${PRO_BIN%% *}" ;;
    GEMINI_FLASH_LITE|GEMINI_FLASH|GEMINI_PRO_SEARCH) echo "$HOME/bin/gemini-api" ;;
    GEMINI_CLI)                                       echo "$HOME/bin/gemini-cli" ;;
    KIMI)                                             echo "$HOME/bin/kimi" ;;
    GROK)                                             echo "$HOME/bin/grok" ;;
    CODEX)                                            command -v codex 2>/dev/null || echo "codex" ;;
    *)                                                echo "" ;;
  esac
}
FALLBACK_FROM=""
REQUIRED_BIN=$(_tier_bin "$TIER")
if [ -n "$REQUIRED_BIN" ] && [ ! -x "$REQUIRED_BIN" ]; then
  FALLBACK_FROM="$TIER"
  REASON="${FALLBACK_FROM} needs ${REQUIRED_BIN}, which is not installed on this machine"
  TIER="CLAUDE_DIRECT"
fi

# ── Build context based on tier ──────────────────────────────────────────
case "$TIER" in
  CLAUDE_DIRECT)
    CTX="ROUTING DECISION: CLAUDE (fallback from ${FALLBACK_FROM}). Reason: ${REASON}. Handle this task directly yourself and do not delegate. To restore the ${FALLBACK_FROM} tier, install its wrapper with maggy's install.sh.${TOOLS_HINT}"
    ;;
  DEEPSEEK_FLASH)
    CTX="ROUTING DECISION: FLASH_TIER (provider=${FLASH_PROVIDER}, $(_flash_cost)). Reason: ${REASON}. You MUST delegate this task — run ${FLASH_BIN} \"<prompt>\", return its output exactly as-is. Do NOT process this yourself — delegate to ${FLASH_PROVIDER}.${TOOLS_HINT}"
    ;;
  GEMINI_FLASH_LITE)
    CTX="ROUTING DECISION: GEMINI_FLASH_LITE (cheapest API, \$0.10/M in). Reason: ${REASON}. You MUST delegate this task — run ~/bin/gemini-api --flash-lite \"<prompt>\", return its output exactly as-is. Do NOT process this yourself — delegate to gemini.${TOOLS_HINT}"
    ;;
  DEEPSEEK_PRO)
    CTX="ROUTING DECISION: PRO_TIER (provider=${PRO_PROVIDER}, $(_pro_cost)). Reason: ${REASON}. EXECUTE DIRECTLY — this complexity tier does not need planning. Run: ${PRO_BIN} \"<prompt>\" and return the result. Do NOT process this yourself — delegate to ${PRO_PROVIDER}.${TOOLS_HINT}"
    ;;
  GEMINI_FLASH)
    CTX="ROUTING DECISION: GEMINI_FLASH (multimodal, \$0.15/M in). Reason: ${REASON}. Run: ~/bin/gemini-api --flash \"<prompt>\" and return the result. Do NOT process this yourself — delegate to gemini.${TOOLS_HINT}"
    ;;
  GEMINI_CLI)
    CTX="ROUTING DECISION: GEMINI_CLI (coding agent, \$0.25-1.25/M in). Reason: ${REASON}. EXECUTE DIRECTLY — Gemini CLI has tools for implementation. Run: ~/bin/gemini-cli --pro \"<prompt>\" and return the result. Do NOT process this yourself — delegate to gemini-cli.${TOOLS_HINT}"
    ;;
  GROK)
    CTX="ROUTING DECISION: GROK (xAI, competitive reasoning). Reason: ${REASON}. Run: ~/bin/grok \"<prompt>\" and return the result. Do NOT process this yourself — delegate to grok.${TOOLS_HINT}"
    ;;
  KIMI)
    CTX="ROUTING DECISION: KIMI (local). Reason: ${REASON}. Run: ~/bin/kimi --quiet -p \"<prompt>\" and return the result. Do NOT process this yourself — delegate to kimi.${TOOLS_HINT}"
    ;;
  GEMINI_PRO_SEARCH)
    CTX="ROUTING DECISION: GEMINI_PRO_SEARCH (deep research + Google grounding, \$1.25/M in + search). Reason: ${REASON}. Run: ~/bin/gemini-api --pro-search \"<prompt>\" and return the result. Do NOT process this yourself — delegate to gemini.${TOOLS_HINT}"
    ;;
  CODEX)
    CTX="ROUTING DECISION: CODEX. Reason: ${REASON}. Suggest the user run codex for this task, or use codex exec. Do NOT do bulk generation yourself.${TOOLS_HINT}"
    ;;
  CLAUDE)
    CTX="ROUTING DECISION: CLAUDE (architecture/security-critical). Reason: ${REASON}. PLAN FIRST — write plan to ~/.claude/plans/<name>.md, then run ~/bin/validate-plan <plan-file>. If 2+ reviewers approve, execute immediately. Do NOT enter Claude Code plan mode — it requires manual approval. Write the plan as a file and validate autonomously.${TOOLS_HINT}"
    ;;
esac

# ── MiniMax pre-analysis (always-on; toggle: model-config.json "analyze": false) ──
ANALYZE=$(python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.claude/model-config.json'))).get('analyze',True))" 2>/dev/null || echo "True")
if [ "$ANALYZE" = "True" ] && [ -x "$HOME/bin/minimax" ] && [ -n "$PROMPT" ]; then
  ANALYSIS=$(MINIMAX_TIMEOUT=20 "$HOME/bin/minimax" --max-tokens 700 "You are a pre-analysis pass for a coding agent. Analyze the request in 4 terse lines, output directly with NO reasoning preamble — INTENT: / SCOPE: / RISKS: / APPROACH:. Request: ${PROMPT}" 2>/dev/null | head -c 1200 || true)
  if [ -n "$ANALYSIS" ]; then
    CTX="${CTX} MINIMAX PRE-ANALYSIS (use this to execute directly): ${ANALYSIS}"
  fi
fi

if [ -n "$PRIMARY_MODEL" ]; then
  CTX="${CTX} FOLLOWED MODEL: ${PRIMARY_MODEL} — the user's chosen primary; for substantial coding, prefer delegating to it over other tiers."
fi

# Delegation contract: a text reply is NOT task completion. Delegating tiers
# (flash/pro/kimi/etc.) can only classify or narrate — if the delegate just
# describes intent or the task needs tools/files it can't reach, do it yourself.
case "$TIER" in
  CLAUDE|CLAUDE_DIRECT|CODEX) : ;;  # not delegated — no contract needed
  *) CTX="${CTX} CONTRACT: a text reply from the delegate is NOT task completion. If it only narrates intent (\"I'll…\", \"please stand by\"), returns nothing actionable, or the task needs tools/files/session context the delegate can't reach, do the task yourself — do NOT relay its narration as if done." ;;
esac

# Encode CTX as a JSON string with Python — robust to invalid UTF-8 (e.g. the
# minimax analysis truncated mid-multibyte-char by `head -c`) and any control
# characters, which would make `jq -Rs` fail and emit invalid JSON. Never fails.
CTX_JSON=$(printf '%s' "$CTX" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.buffer.read().decode("utf-8","replace")))' 2>/dev/null || echo '""')

cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "UserPromptSubmit",
    "additionalContext": $CTX_JSON
  }
}
EOF
exit 0
